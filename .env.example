# Public application URL used for links and deployment metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and browser-safe anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Cloud model provider credentials. Keep all provider keys server-side.
# Leave AI_PROVIDER unset for cloud inference. Set AI_PROVIDER=mock only for local UI work.
AI_PROVIDER=
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional routing/model controls.
GUNMAR_CEREBRAS_MODEL=gpt-oss-120b
GUNMAR_GROQ_MODEL=openai/gpt-oss-120b
GUNMAR_OPENROUTER_MODEL=openrouter/free
GUNMAR_PRIMARY_PROVIDER=cerebras
GUNMAR_PROVIDER_ORDER=cerebras,groq,openrouter
GUNMAR_PROVIDER_TIMEOUT_MS=30000
GUNMAR_ENSEMBLE_ENABLED=false
GUNMAR_MEMORY_ENABLED=true
GUNMAR_LEARNING_ENABLED=true
GUNMAR_EMBEDDING_MODEL=
GUNMAR_EMBEDDING_PROVIDER=openrouter
GUNMAR_EMBEDDING_DIMENSIONS=1536
GUNMAR_EMBEDDING_VERSION=1
GUNMAR_EMBEDDING_TIMEOUT_MS=15000
GUNMAR_CHAT_RATE_LIMIT=30
GUNMAR_CHAT_RATE_WINDOW_SECONDS=60
